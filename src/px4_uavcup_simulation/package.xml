  <version>0.1.0</version>
  <description>PC-only Gazebo and PX4 SITL assets for UAV Cup ArUco testing.</description>
  <maintainer email="anh.nguyenvantuan54@hcmut.edu.vn">dolphiinn</maintainer>
  <license>Apache-2.0</license>

