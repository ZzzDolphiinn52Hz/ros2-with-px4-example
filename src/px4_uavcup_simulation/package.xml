  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>px4_uavcup_control</exec_depend>
  <exec_depend>px4_uavcup_perception</exec_depend>
  <exec_depend>px4_uavcup_px4_bridge</exec_depend>
