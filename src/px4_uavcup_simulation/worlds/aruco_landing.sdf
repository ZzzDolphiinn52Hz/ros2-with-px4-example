<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="aruco_landing">
    <physics name="1ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>true</grid>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.78 0.90 1</background>
      <shadows>true</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- UAV starts here on the ground. Arm/takeoff remain manual in QGC. -->
    <model name="takeoff_pad">
      <static>true</static>
      <pose>-1 0 0.003 0 0 0</pose>
      <link name="pad_link">
        <visual name="pad_visual">
          <geometry><box><size>0.8 0.8 0.006</size></box></geometry>
          <material>
            <ambient>0.08 0.22 0.45 1</ambient>
            <diffuse>0.10 0.30 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The landing target is 2 m east of the takeoff position. -->
    <include>
      <uri>model://aruco_cargo_80mm</uri>
      <name>aruco_cargo_80mm</name>
      <pose>1 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://x500_uavcup_aruco</uri>
      <name>x500_uavcup_aruco</name>
      <pose>-1 0 0.006 0 0 0</pose>
    </include>
  </world>
</sdf>
