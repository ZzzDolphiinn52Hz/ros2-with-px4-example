<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_uavcup_slam</name>
  <version>0.1.0</version>
  <description>
    Bridge Gazebo LiDAR + PX4 odometry into ROS 2 for slam_toolbox mapping
    on urban_uavcup (PX4 SITL x500_lidar_2d).
  </description>
  <maintainer email="anh.nguyenvantuan54@hcmut.edu.vn">dolphiinn</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ros_gz_bridge</depend>
  <depend>slam_toolbox</depend>
  <depend>nav2_map_server</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
