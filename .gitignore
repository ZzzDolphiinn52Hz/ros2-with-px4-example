# ROS 2 / colcon build outputs
/build/
/build_*/
**/build/
/install/
/install_*/
**/install/
/log/
/log_*/
**/log/
.devel/
**/.devel/
.colcon/
**/.colcon/

# CMake / catkin generated files
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
**/CTestTestfile.cmake
**/CTestConfiguration.ini
**/colcon_build.rc
**/*.cmake

# ROS generated artifacts
*.msg
*.srv
*.action
**/rosidl_*_arguments*.json
**/ament_cmake_*/
**/ament_cmake_index/

# Python cache and virtual environments
__pycache__/
*.py[cod]
*.so
.venv/
.venv-depth/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo
*~

# C/C++ compiled artifacts
*.o
*.obj
*.a
*.dylib
*.dll
*.exe

# OS files
.DS_Store
Thumbs.db

# Local environment / secrets
.env
.env.*
*.local

# Downloaded perception dependencies and neural-network weights
/third_party/Depth-Anything-V2/
/models/*.pth
/models/*.engine

# Local perception captures and calibration datasets
/artifacts/
/run/
/zipdepth_*.png
/zipdepth_*.json

# Optional: keep selected launch/config files tracked if needed
!src/**/launch/*.launch
!src/**/config/*.yaml
!src/**/config/*.yml

